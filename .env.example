# ===== TaskFlow: variables de entorno =====
# Ubicación: raíz del proyecto (junto a docker-compose.yml). El backend también lee backend/.env.
# Tras cambiarlo: docker compose up -d --force-recreate

# --- Credenciales (las únicas que son secretas) ---
# MongoDB Atlas. Si la clave tiene @ : / ? codifícalos: %40 %3A %2F %3F
# Si lo dejas vacío en Docker, usa el Mongo local: mongodb://mongo:27017/taskflow
MONGO_URI=mongodb+srv://diegomonsalvetavera:diego3185356995@cluster0.j6px7ap.mongodb.net/?appName=Cluster0zñ

# Redis en la nube (rediss:// con doble s si exige TLS; Redis >= 6.2).
# Si lo dejas vacío en Docker, usa el Redis local: redis://redis:6379
REDIS_URL=redis://default:jINLjLRpaE1WjYWCyF2E8IvxA7oR0eUV@professional-cream-agreeable-30869.db.redis.io:12893

# --- Opcionales (valores por defecto entre paréntesis) ---
MONGO_COLLECTION=solicitudes      # (solicitudes)
CACHE_TTL_SECONDS=60              # (60)
CACHE_TTL_ENCURSO_SECONDS=5       # (5)
WORKER_DELAY_MS=3000              # (3000)
WORKER_POLL_SECONDS=5             # (5)

# --- Puertos expuestos por docker compose ---
FRONTEND_PORT=8081                # (8080)
BACKEND_PORT=3000                 # (3000)
MONGO_PORT=27018                  # (27017)
REDIS_PORT=6379                   # (6379)

# --- Solo desarrollo sin Docker ---
# PORT=3000                       # puerto del backend (3001 si no se define)
# Frontend (frontend/.env): VITE_API_URL=  (por defecto /api) y VITE_BACKEND=http://localhost:3000 (proxy de Vite)
